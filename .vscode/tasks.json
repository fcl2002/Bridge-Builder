{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build SFML Modular",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17", 
        "-I",
        "C:/SFML-3.0.2/include",
        "graphics/main.cpp",
        "graphics/src/Scene.cpp",
        "graphics/src/Car.cpp",
        "graphics/src/HUD.cpp",
        "graphics/src/Level.cpp",
        "graphics/src/Level2.cpp",
        "graphics/src/Level3.cpp",
        "graphics/src/Level4.cpp",
        "-LC:/SFML-3.0.2/lib",
        "-lsfml-graphics",
        "-lsfml-window",
        "-lsfml-system",
        "-o",
        "graphics/main.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
} 