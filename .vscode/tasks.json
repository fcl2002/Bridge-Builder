{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build SFML",
      "type": "shell",
      "command": "g++",
      "args": [
        "-IC:/SFML-3.0.2/include",
        "${file}",
        "-LC:/SFML-3.0.2/lib",
        "-lsfml-graphics",
        "-lsfml-window",
        "-lsfml-system",
        "-o",
        "${fileDirname}/main.exe"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build SFML Modular",
      "type": "shell",
      "command": "g++",
      "args": [
        "-IC:/SFML-3.0.2/include",
        "graphics/main.cpp",
        "graphics/src/Scene.cpp",
        "graphics/src/Car.cpp",
        "graphics/src/HUD.cpp",
        "graphics/src/Level.cpp",
        "graphics/src/Level2.cpp",
        "-LC:/SFML-3.0.2/lib",
        "-lsfml-graphics",
        "-lsfml-window",
        "-lsfml-system",
        "-o",
        "graphics/main.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}